# Credenciales de Supabase (Project Settings → API)
# Copia este archivo a .env y rellena los valores reales.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: dominio cuyos correos reciben rol admin en la interfaz
# (ej. admin.udg.mx → director@admin.udg.mx entra como admin).
# El acceso real a los datos siempre lo decide RLS en la base.
VITE_ADMIN_EMAIL_DOMAIN=

# Service Role Key — SOLO para scripts de administración locales (invitar_profesores.js).
# Omite RLS: NUNCA la expongas en el frontend ni la subas al repositorio.
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_KEY=tu-service-role-key
