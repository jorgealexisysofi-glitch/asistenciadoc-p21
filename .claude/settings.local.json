      "PowerShell(node --version)",
      "PowerShell(npm --version)",
      "PowerShell($r = Invoke-WebRequest -Uri http://localhost:5173/ -UseBasicParsing; $r.StatusCode; $r.Content.Substring\\(0, 400\\))",
